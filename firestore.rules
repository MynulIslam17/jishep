rules_version = '2';

// GPS PARA EL CIELO — Firestore rules.
// Every write is limited to the fields the app actually sends, with types
// and sizes checked. The demo/seed tools use the Admin SDK (rules bypassed).

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email/password accounts must click the verification link first.
    // Google, Apple and phone sign-ins are verified by their provider.
    function verified() {
      return request.auth.token.get('email_verified', false) == true
        || request.auth.token.firebase.sign_in_provider
          in ['google.com', 'apple.com', 'phone'];
    }

    function data() {
      return request.resource.data;
    }

    // Fields this write adds or changes.
    function changed() {
      return resource == null
        ? data().keys()
        : data().diff(resource.data).affectedKeys();
    }

    function optString(field, max) {
      return !(field in data()) || data()[field] == null
        || (data()[field] is string && data()[field].size() <= max);
    }

    function optNumberIn(field, lo, hi) {
      return !(field in data()) || data()[field] == null
        || (data()[field] is number && data()[field] >= lo && data()[field] <= hi);
    }

    function optIntIn(field, lo, hi) {
      return !(field in data())
        || (data()[field] is int && data()[field] >= lo && data()[field] <= hi);
    }

    function optTimestamp(field) {
      return !(field in data()) || data()[field] is timestamp;
    }

    // ---------------------------------------------------------------
    // users/{uid}: profile, home location and prayer preferences.
    // ---------------------------------------------------------------
    function validProfile() {
      return data().keys().hasOnly([
          'fullName', 'email', 'phone', 'avatarUrl', 'avatarBase64',
          'address', 'churchAffiliation', 'dailyPrayerTarget',
          'prayerCycleTarget', 'radiusHomes', 'searchRadiusKm',
          'latitude', 'longitude', 'prayerCycleStartedAt',
          'prayerIntention', 'createdAt', 'updatedAt'])
        && optString('fullName', 100)
        && optString('email', 254)
        && optString('phone', 20)
        && optString('avatarUrl', 2048)
        // Small profile photo (no Firebase Storage).
        && optString('avatarBase64', 300000)
        && optString('address', 300)
        && optString('churchAffiliation', 150)
        && optIntIn('dailyPrayerTarget', 1, 100)
        && optIntIn('prayerCycleTarget', 1, 1000)
        && optIntIn('radiusHomes', 1, 200)
        && optNumberIn('searchRadiusKm', 0.1, 50)
        && optNumberIn('latitude', -90, 90)
        && optNumberIn('longitude', -180, 180)
        && optTimestamp('prayerCycleStartedAt')
        && optString('prayerIntention', 120)
        && optTimestamp('createdAt')
        && optTimestamp('updatedAt');
    }

    // The profile email must be the account's own sign-in email
    // (empty for phone-only accounts).
    function emailMatchesAccount() {
      return !('email' in changed())
        || data().email == ''
        || data().email.lower()
          == request.auth.token.get('email', '').lower();
    }

    // A phone number is stored only after it was verified by SMS and
    // linked to this account.
    function phoneMatchesAccount() {
      return !('phone' in changed())
        || data().phone == null
        || data().phone == request.auth.token.get('phone_number', '');
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validProfile()
        && emailMatchesAccount()
        && phoneMatchesAccount();
      allow delete: if isOwner(uid);

      // The user's own prayed / visited / invited / follow-up state.
      match /household_status/{householdId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && verified()
          && householdId.size() <= 128
          && data().keys().hasOnly([
              'isPrayed', 'isVisited', 'isInvited', 'hasFollowUp',
              'followUpDate', 'notes', 'residentName', 'address',
              'prayedAt', 'updatedAt'])
          && data().isPrayed is bool
          && data().isVisited is bool
          && data().isInvited is bool
          && data().hasFollowUp is bool
          && optString('followUpDate', 64)
          && optString('notes', 2000)
          && optString('residentName', 120)
          && optString('address', 300)
          && optTimestamp('prayedAt')
          && data().updatedAt == request.time;
      }

      // Devices that receive push notifications: one document per FCM
      // token (the document id), so a device is never stored twice. Only
      // the owner reads or writes them; a server (Admin SDK) sends.
      match /devices/{token} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && token.size() <= 4096
          && data().keys().hasOnly(['token', 'platform', 'updatedAt'])
          && data().token == token
          && data().platform in ['ios', 'android']
          && data().updatedAt == request.time;
      }

      // Address checks (Melissa) the user asked for, one per household.
      // Written only by the enrichHousehold Cloud Function (Admin SDK);
      // the owner may read or delete them, never write.
      match /enrichment/{householdId} {
        allow read, delete: if isOwner(uid);
        allow write: if false;
      }

      // Melissa gap-fill results (addresses near a point where Overture has
      // fewer than 50 homes). Written only by discoverNearby.
      match /gap_areas/{areaId} {
        allow read, delete: if isOwner(uid);
        allow write: if false;
      }

      // Prayer history: one event per home per round
      // ({roundId}_{householdId}), written with the status. Earlier rounds
      // are never overwritten (a new round has a new id); the owner may
      // delete an event (un-pray in the same round, account deletion).
      match /prayer_log/{eventId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && verified()
          && eventId.size() <= 200
          && data().keys().hasOnly(['householdId', 'roundId', 'prayedAt',
                                    'createdAt'])
          && data().householdId is string
          && data().householdId.size() <= 128
          && data().roundId is string
          && data().roundId.size() <= 40
          && eventId == data().roundId + '_' + data().householdId
          && data().prayedAt is timestamp
          && data().createdAt == request.time;
      }

      // Prayer rounds: the homes in each round (the same neighborhood).
      match /prayer_rounds/{roundId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && verified()
          && roundId.size() <= 40
          && data().keys().hasOnly(['startedAt', 'completedAt',
                                    'householdIds', 'members', 'center',
                                    'target', 'size', 'updatedAt'])
          && optTimestamp('startedAt')
          && optTimestamp('completedAt')
          && (!('householdIds' in data())
              || (data().householdIds is list
                  && data().householdIds.size() <= 200))
          // Members: id, point, street, city only (no owner data).
          && (!('members' in data())
              || (data().members is list
                  && data().members.size() <= 200))
          && (!('center' in data()) || data().center is latlng)
          && optIntIn('target', 0, 1000)
          && optIntIn('size', 0, 1000)
          && data().updatedAt == request.time;
      }

      // Melissa property data (owner names): server only. The app gets it
      // through the discoverOwners function; no client reads or writes,
      // the owner included (licence: not exported to devices as data).
      match /owner_areas/{areaId} { allow read, write: if false; }
      match /owner_scans/{scanId} { allow read, write: if false; }
      match /owner_properties/{propertyId} { allow read, write: if false; }

      // In-app notifications. Clients can only mark them read or delete.
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid)
          && data().keys().hasOnly([
              'title', 'message', 'type', 'isRead', 'actionRoute',
              'timestamp'])
          && data().title is string && data().title.size() <= 200
          && data().message is string && data().message.size() <= 2000
          && data().type in ['prayerReminder', 'followUpDue', 'milestone',
                             'scripture', 'churchNews']
          && data().isRead is bool
          && optString('actionRoute', 200)
          && data().timestamp == request.time;
        allow update: if isOwner(uid)
          && changed().hasOnly(['isRead'])
          && data().isRead is bool;
      }
    }

    // Shared household directory. Managed with the Admin SDK
    // (tool/seed_households) or the Firebase console.
    match /households/{householdId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Household cells from Overture (tool/overture_cells): one gzipped
    // file per geohash cell. Written only with admin access (seed script).
    match /cells/{id} { allow read: if request.auth != null; allow write: if false; }

    // Contact Support messages: users can send them, and read or delete
    // only their own (account deletion removes them). Admins use the
    // Admin SDK / console.
    match /support_messages/{messageId} {
      allow create: if signedIn()
        && verified()
        && data().keys().hasOnly(['uid', 'email', 'message', 'status',
                                  'createdAt'])
        && data().uid == request.auth.uid
        && data().message is string
        && data().message.size() > 0
        && data().message.size() <= 5000
        && optString('email', 254)
        && data().status == 'open'
        && data().createdAt == request.time;
      allow read, delete: if signedIn()
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Shared Melissa property cache, discovery locks and credit counters:
    // written and read only by Cloud Functions (Admin SDK).
    match /owner_scans/{id} { allow read, write: if false; }
    match /owner_properties/{id} { allow read, write: if false; }
    match /owner_areas/{id} { allow read, write: if false; }
    match /discovery_jobs/{id} { allow read, write: if false; }
    match /melissa_usage/{document=**} { allow read, write: if false; }

    // Anything else is closed.
  }
}
