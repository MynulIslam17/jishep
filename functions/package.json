{
  "name": "gps-cielo-functions",
  "private": true,
  "description": "Cloud Functions for GPS Para el Cielo (Melissa address checks).",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test:unit": "node --test --test-concurrency=1 --require ./test/no_network.js test/melissa.test.js",
    "test": "firebase emulators:exec --only firestore --project demo-gps-cielo-functions --config ../firebase.json \"node --test --test-concurrency=1 --require ./test/no_network.js test/\"",
    "test:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node --test --test-concurrency=1 --require ./test/no_network.js test/"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0"
  }
}
