# Deploy-time settings for project gps-para-el-cielo (not secret).
# The Melissa key is NOT here: it lives only in Secret Manager
# (firebase functions:secrets:set MELISSA_CREDIT_LICENSE).
MELISSA_PER_USER_DAILY_LOOKUPS=20
MELISSA_GLOBAL_DAILY_CREDITS=2000
MELISSA_CACHE_DAYS=365
# Owner names stay off until Melissa's license is confirmed.
MELISSA_ALLOW_OWNER_NAMES=true
# Gap-filler stays off until production spending is approved.
MELISSA_GAP_FILL_ENABLED=false
MELISSA_GAP_PER_USER_DAILY=3
MELISSA_GAP_DAILY_CREDITS=300
MELISSA_GAP_VERIFY_RESIDENTIAL=false
# true only after App Check is registered for both apps.
ENFORCE_APP_CHECK=false
# Melissa-first neighborhood (discoverOwners). OFF until the pilot is
# approved AND Melissa confirms owner names may be shown/stored/shared.
MELISSA_OWNER_DISCOVERY_ENABLED=true
MELISSA_OWNER_PER_USER_DAILY=5
MELISSA_OWNER_DAILY_CREDITS=2000
MELISSA_OWNER_MAX_LOOKUPS=80
MELISSA_OWNER_RADIUS_MILES=1
MELISSA_OWNER_SHARED_CACHE=true
# Cache-first budgets (estimated credits; Melissa's bill is the authority).
MELISSA_OWNER_MONTHLY_CREDITS=9000
MELISSA_OWNER_REQUEST_MAX_CREDITS=920
# Exclusions (not found / commercial / no owner): no owner data stored.
MELISSA_OWNER_NEGATIVE_CACHE_DAYS=365
# Blueprint 2026-11-24: server searches only around the saved home;
# paid discovery needs a verified account.
MELISSA_OWNER_LOCATION_TOLERANCE_M=250
MELISSA_OWNER_REQUIRE_VERIFIED=true
# Paid Melissa only with a valid Firebase App Check token (soft gate; cache
# still served). ENFORCE_APP_CHECK (hard, rejects everything) stays false
# until builds without App Check are retired.
MELISSA_REQUIRE_APP_CHECK=true
# Pending discovery queue (src/queue.js, docs/PENDING_DISCOVERY_QUEUE.md)
MELISSA_OWNER_QUEUE_ENABLED=true
MELISSA_OWNER_QUEUE_DAILY_NEW=50
MELISSA_OWNER_QUEUE_MAX_OPEN=200
MELISSA_OWNER_QUEUE_JOBS_PER_RUN=5
